# =============================================================================
# Environnements virtuels Python & configuration
# =============================================================================
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.env
.env.*
!.env.example

# =============================================================================
# Binaires lourds externes (à télécharger séparément)
# =============================================================================
# Solveur FDTD openEMS (binaires Windows / Linux)
openEMS/
openems/
openEMS*/
openems*/

# Visualiseur 3D ParaView (archives et dossiers décompressés)
ParaView*/
paraview*/
ParaView-*
paraview-*

# =============================================================================
# Caches et artefacts Python & Node
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
node_modules/

