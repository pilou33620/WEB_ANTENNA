scratch/
scratch_*.json
*.vtr
*.vts
*.vti
*.vtk
*.vtu
*.pvtr
*.pvtu
*.h5
*.hdf5
dump/
dumps/
*.log

# =============================================================================
# Projets locaux, calculs et réglages utilisateur
# =============================================================================
# Dossiers de travail choisis localement par l'utilisateur
projets/
projects/
calculs/
.antenne-openems.json
croisement-*.json
!croisement-g-y0.json

# =============================================================================
# Exports de simulation (Touchstone, vidéos, rapports)
# =============================================================================
# Fichiers Touchstone (paramètres S exportés)
*.s1p
*.s2p
*.s3p
*.s4p
*.snp
*.ts

# Captures vidéo de champ de la visionneuse
*.webm
*.mp4
*.avi
*.gif

# Rapports générés
rapport*.html
rapport*.pdf
rapport*.md

# =============================================================================
# Fichiers de fabrication et cartes locales (IPC-2581 lourds)
# =============================================================================
# Seuls les fichiers d'essai du dépôt (antenna4c.xml, test/*.xml) sont suivis.
# Les exports industriels lourds testés localement ne doivent pas être versionnés.
*.xml
!antenna4c.xml
!test/*.xml
!test/**/*.xml
*.cvg
*.ipc
*.ipc2581
*.zip

# =============================================================================
# Le secret du mode IA
# =============================================================================
# La clé Google AI Studio que le serveur rend à la page (GET /api/ia/cle).
# Elle est personnelle et facturable : elle n'a rien à faire dans l'historique
# d'un dépôt, d'où qu'il soit cloné ensuite.
api_key_free_ia_studio.txt

